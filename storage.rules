rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check admin role (Custom Claims or Firestore fallback)
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token != null && request.auth.token.admin == true) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Academic Resources storage folder: StudyHub/{year}/{semester}/{subject}/{resourceType}/{filename}
    match /StudyHub/{allPaths=**} {
      // Public read access so students can view/download resources
      allow read: if true;
      // Writes (upload, replace, delete) restricted strictly to Admins
      allow write: if isAdmin();
    }
    
    // User Avatars & Profile uploads: Only profile owner can write
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Root / Fallback Storage rules: Admin only writes
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
